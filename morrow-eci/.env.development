# `next dev` only: the dev server is on :3000 and the host is on :5179, so the
# client needs an absolute base and the host's CORS policy (Surface:AllowedOrigins)
# lets it through. The exported build has no such file and talks to its own
# origin, because there one process serves both. See lib/api.ts.
NEXT_PUBLIC_ECI_API_BASE=http://localhost:5179
