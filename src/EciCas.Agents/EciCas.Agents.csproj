<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\EciCas.Core\EciCas.Core.csproj" />
    <ProjectReference Include="..\EciCas.Bus\EciCas.Bus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ImpulseAgent exposes its nudge tables internally so a test can assert
         slow-colouring stays smaller than every instant nudge without pinning
         literals that are meant to be tuned. -->
    <InternalsVisibleTo Include="EciCas.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Parquet.Net" Version="6.1.0" />
    <!-- Windows-only at runtime (AccessibilityToolkit checks OperatingSystem.IsWindows
         before touching it); the package itself targets any OS so this project doesn't
         need a -windows TFM just to reference it. -->
    <PackageReference Include="System.Speech" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
