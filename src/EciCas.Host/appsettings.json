{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "EciCas": "Information"
    }
  },
  "Console": {
    "Verbose": false
  },
  "Governance": {
    "BundleRoster": ["Impulse", "Recall", "Identity", "Hindsight"],
    "BundleTimeoutMs": 15000,
    "MaxRevisionPasses": 1
  },
  "Security": {
    "RulesPath": "config/security-rules.json"
  },
  "Instructions": {
    "Directory": "instructions"
  },
  "Identity": {
    "Profile": "",
    "DefaultName": "Morrow"
  },
  "AgentState": {
    "Path": "memory.jsonl"
  },
  "Archive": {
    "Directory": "archive"
  },
  "Surface": {
    "Url": "http://localhost:5179",
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "Shell": {
    "//": "The desktop shell only. A key is named by the character it types, with optional Ctrl+/Shift+/Alt+/Win+ prefixes; it is resolved through the keyboard layout in front at the time. These keys are watched, not claimed -- they still type normally everywhere else, which also means typing one triggers Morrow.",
    "VoiceKey": "-",
    "InteractKey": "|",
    "Width": 260,
    "Height": 340,
    "SessionPath": "/?mute=1",
    "OverlayPath": "/overlay/"
  },
  "Knobs": {
    "MaxSentences": 2,
    "ReflectionEvery": 5,
    "PerceptionChars": 512,
    "ContextTurns": 5,
    "RecallDepth": 5,
    "Mood": "Neutral"
  },
  "Utterances": {
    "ThreadThreshold": 0.86,
    "ConsolidatorCandidates": 5,
    "ConsolidatorEnabled": false,
    "ExtractorEnabled": false,
    "ExtractorMaxFacts": 24,
    "MinContentWords": 1,
    "TopK": 5,
    "ReadMinScore": 0.60,
    "FanoutWidth": 40,
    "PickMax": 8,
    "DiversityLambda": 0.7,
    "RareMax": 2,
    "LexicalWeight": 0.15
  },
  "Passages": {
    "TopK": 3,
    "MinScore": 0.625,
    "MaxPairsFromPassages": 3
  },
  "Embedding": {
    "Provider": "onnx",
    "ModelPath": "models/embedding/multilingual-e5-small/model.onnx",
    "VocabPath": "models/embedding/multilingual-e5-small/sentencepiece.bpe.model",
    "MaxTokens": 256,
    "ApiProvider": "openai",
    "ApiModel": "text-embedding-3-small"
  },
  "Impulse": {
    "ReflexFloor": 0.88,
    "ReflexMargin": 0.03
  },
  "Cataloger": {
    "BatchSize": 1
  },
  "Reflection": {
    "MaxIdeaGeneration": 1,
    "BatchSize": 5,
    "EagernessThreshold": 0.6
  },
  "RoutingManifest": {
    "Agents": {
      "Perception": { "Subscribes": [] },
      "TurnWindow": { "Subscribes": ["events.perception", "events.conclusion"] },
      "Impulse": { "Subscribes": ["events.perception", "system.control"] },
      "Recall": { "Subscribes": ["events.perception"] },
      "Identity": { "Subscribes": ["events.perception", "system.control"] },
      "Hindsight": { "Subscribes": ["events.perception"] },
      "Governance": { "Subscribes": ["events.perception", "events.advisories", "events.verdict"] },
      "Intent": { "Subscribes": ["events.bundle"] },
      "Security": { "Subscribes": ["events.proposal"] },
      "Action": { "Subscribes": ["events.action"] },
      "Scribe": { "Subscribes": ["events.perception", "events.conclusion"] },
      "Reflection": { "Subscribes": ["events.conclusion"] },
      "ArchiveLogger": { "Subscribes": ["*"] },
      "ConsoleSubscriber": { "Subscribes": ["*"] },
      "TurnLog": { "Subscribes": ["*"] },
      "TelemetryLog": { "Subscribes": ["system.telemetry"] }
    }
  },
  "TurnLog": {
    "Retain": 100,
    "SettleMs": 3000,
    "Path": "",
    "CostPath": "cost.json"
  },
  "_energy": "MaxHours is the ceiling M, in hours of regen. AnnualBudgetUsd is R, and the only number that sets annual exposure.",
  "Energy": {
    "AnnualBudgetUsd": 5.00,
    "MaxHours": 48,
    "Path": "energy.json"
  },
  "TelemetryLog": {
    "Directory": "telemetry",
    "FlushEvery": 25,
    "FlushMs": 5000
  },
  "_maintenance": "Not a tier. The rebuild runs whichever tier booted -- a Free boot still repairs its memory with the good model, because a tier is what the persona thinks with and this is not the persona thinking. Replaces lists the model ids whose extractions may be thrown away; rows naming no model at all are always included. Leave Rebuild out entirely to switch the pass off.",
  "Maintenance": {
    "Rebuild": {
      "Provider": "openai",
      "Model": "gpt-5.6-luna",
      "Effort": "none",
      "PricePerMtok": { "Input": 0.20, "Output": 1.20 }
    },
    "Replaces": [ "qwen3.5-2b" ]
  },
  "Substrates": {
    "Providers": {
      "openai": {
        "BaseUrl": "https://api.openai.com/v1/",
        "ApiKeyEnvironmentVariable": "OPENAI_API_KEY",
        "TimeoutMs": 60000,
        "CircuitOpenMs": 5000
      },
      "mistral": {
        "BaseUrl": "https://api.mistral.ai/v1/",
        "ApiKeyEnvironmentVariable": "MISTRAL_API_KEY",
        "TimeoutMs": 60000,
        "CircuitOpenMs": 5000
      },
      "local": {
        "BaseUrl": "http://localhost:8080/v1/",
        "TimeoutMs": 300000,
        "CircuitOpenMs": 15000,
        "MaxConcurrent": 2
      }
    },
    "Agents": {
      "Intent": { "Provider": "mock" },
      "Reflection": { "Provider": "mock" },
      "consolidator": { "Provider": "mock" }
    }
  }
}
