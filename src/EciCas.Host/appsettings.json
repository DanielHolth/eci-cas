{
  "Governance": {
    "BundleRoster": ["Impulse", "Reasoning", "Recall", "Self"],
    "BundleTimeoutMs": 4000,
    "MaxRevisionPasses": 1
  },
  "Security": {
    "RulesPath": "config/security-rules.json"
  },
  "Archive": {
    "Path": "memory.jsonl"
  },
  "Surface": {
    "Url": "http://localhost:5179",
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "Recall": {
    "MaxPerPath": 3
  },
  "Consolidator": {
    "BatchSize": 3
  },
  "Reflection": {
    "MaxIdeaGeneration": 1
  },
  "RoutingManifest": {
    "Agents": {
      "Perception": { "Subscribes": [] },
      "Impulse": { "Subscribes": ["events.perception"] },
      "Reasoning": { "Subscribes": ["events.perception"] },
      "Recall": { "Subscribes": ["events.lookup-paths"] },
      "Self": { "Subscribes": ["events.perception", "system.control"] },
      "Governance": { "Subscribes": ["events.perception", "events.advisories", "events.verdict"] },
      "Intent": { "Subscribes": ["events.bundle"] },
      "Security": { "Subscribes": ["events.proposal"] },
      "Action": { "Subscribes": ["events.action"] },
      "Consolidator": { "Subscribes": ["events.bundle"] },
      "Reflection": { "Subscribes": ["events.conclusion"] },
      "ArchiveLogger": { "Subscribes": ["*"] },
      "ConsoleSubscriber": { "Subscribes": ["*"] },
      "SseBroadcaster": { "Subscribes": ["*"] }
    }
  },
  "Budget": {
    "Tiers": {
      "fast-low": "mock",
      "fast-medium": "mock",
      "fast-high": "mock",
      "slow-low": "mock",
      "slow-medium": "mock",
      "slow-high": "mock"
    }
  },
  "SubstrateProvider": {
    "BaseUrl": "https://api.openai.com/v1/",
    "ApiKeyEnvironmentVariable": "OPENAI_API_KEY",
    "Models": {
      "fast-low": "gpt-4o-mini",
      "fast-medium": "gpt-4o-mini",
      "fast-high": "gpt-4o",
      "slow-low": "gpt-4o-mini",
      "slow-medium": "gpt-4o",
      "slow-high": "gpt-4o"
    },
    "CostPerTokenUsd": 0.0000006
  }
}
