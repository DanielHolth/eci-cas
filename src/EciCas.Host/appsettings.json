{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "EciCas": "Information"
    }
  },
  "Console": {
    "Verbose": false
  },
  "Governance": {
    "BundleRoster": ["Impulse", "Recall", "Identity", "Hindsight"],
    "BundleTimeoutMs": 15000,
    "MaxRevisionPasses": 1
  },
  "Security": {
    "RulesPath": "config/security-rules.json"
  },
  "Instructions": {
    "Directory": "instructions"
  },
  "Identity": {
    "Profile": "",
    "DefaultName": "Morrow"
  },
  "AgentState": {
    "Path": "memory.jsonl"
  },
  "Archive": {
    "Directory": "archive",
    "SharedCategories": [ "assistant" ]
  },
  "Surface": {
    "Url": "http://localhost:5179",
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "Knobs": {
    "MaxSentences": 2,
    "ReflectionEvery": 5,
    "PerceptionChars": 512,
    "ContextTurns": 5,
    "RecallDepth": 5,
    "Mood": "Neutral"
  },
  "Utterances": {
    "ThreadThreshold": 0.86,
    "ConsolidatorCandidates": 5,
    "ConsolidatorEnabled": false,
    "MinContentWords": 1,
    "TopK": 5,
    "ReadMinScore": 0.55,
    "DiversityLambda": 0.7,
    "RareMax": 2,
    "LexicalWeight": 0.15
  },
  "Passages": {
    "TopK": 3,
    "MinScore": 0.625,
    "MaxPairsFromPassages": 3
  },
  "Embedding": {
    "Provider": "onnx",
    "ModelPath": "models/embedding/model.onnx",
    "VocabPath": "models/embedding/vocab.txt",
    "MaxTokens": 256,
    "ApiProvider": "openai",
    "ApiModel": "text-embedding-3-small"
  },
  "Impulse": {
    "ReflexFloor": 0.88,
    "ReflexMargin": 0.03
  },
  "Cataloger": {
    "BatchSize": 1
  },
  "Reflection": {
    "MaxIdeaGeneration": 1,
    "BatchSize": 5,
    "EagernessThreshold": 0.6
  },
  "RoutingManifest": {
    "Agents": {
      "Perception": { "Subscribes": [] },
      "TurnWindow": { "Subscribes": ["events.perception", "events.conclusion"] },
      "Impulse": { "Subscribes": ["events.perception", "system.control"] },
      "Recall": { "Subscribes": ["events.perception"] },
      "Identity": { "Subscribes": ["events.perception", "system.control"] },
      "Hindsight": { "Subscribes": ["events.perception"] },
      "Governance": { "Subscribes": ["events.perception", "events.advisories", "events.verdict"] },
      "Intent": { "Subscribes": ["events.bundle"] },
      "Security": { "Subscribes": ["events.proposal"] },
      "Action": { "Subscribes": ["events.action"] },
      "Scribe": { "Subscribes": ["events.perception"] },
      "Reflection": { "Subscribes": ["events.conclusion"] },
      "ArchiveLogger": { "Subscribes": ["*"] },
      "ConsoleSubscriber": { "Subscribes": ["*"] },
      "SseBroadcaster": { "Subscribes": ["*"] },
      "TurnLog": { "Subscribes": ["*"] },
      "TelemetryLog": { "Subscribes": ["system.telemetry"] }
    }
  },
  "Sse": {
    "ExcludedMetaKeys": [ "intent.prompt" ]
  },
  "TurnLog": {
    "Retain": 100,
    "SettleMs": 3000,
    "Path": "",
    "CostPath": "cost.json"
  },
  "TelemetryLog": {
    "Directory": "telemetry",
    "FlushEvery": 25,
    "FlushMs": 5000
  },
  "Substrates": {
    "Providers": {
      "openai": {
        "BaseUrl": "https://api.openai.com/v1/",
        "ApiKeyEnvironmentVariable": "OPENAI_API_KEY",
        "TimeoutMs": 60000,
        "CircuitOpenMs": 5000
      },
      "mistral": {
        "BaseUrl": "https://api.mistral.ai/v1/",
        "ApiKeyEnvironmentVariable": "MISTRAL_API_KEY",
        "TimeoutMs": 60000,
        "CircuitOpenMs": 5000
      },
      "local": {
        "BaseUrl": "http://localhost:8080/v1/",
        "TimeoutMs": 300000,
        "CircuitOpenMs": 15000,
        "MaxConcurrent": 2
      }
    },
    "Agents": {
      "Intent": { "Provider": "mock" },
      "Reflection": { "Provider": "mock" },
      "consolidator": { "Provider": "mock" }
    }
  }
}
