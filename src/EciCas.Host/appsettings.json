{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "EciCas": "Information"
    }
  },
  "Console": {
    "Verbose": false
  },
  "Governance": {
    "BundleRoster": ["Impulse", "Recall", "Self"],
    "BundleTimeoutMs": 15000,
    "MaxRevisionPasses": 1
  },
  "Security": {
    "RulesPath": "config/security-rules.json"
  },
  "Archive": {
    "Path": "memory.jsonl",
    "Directory": "archive",
    "SharedCategories": [ "system", "self" ]
  },
  "Surface": {
    "Url": "http://localhost:5179",
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "Recall": {
    "RowsPerWorker": 50,
    "MaxConcurrentRecalls": 6
  },
  "Reasoning": {
    "MaxSelectedPairs": 3
  },
  "Passages": {
    "TopK": 3,
    "MinScore": 0.45,
    "MaxPairsFromPassages": 3
  },
  "Embedding": {
    "Provider": "onnx",
    "ModelPath": "models/embedding/model.onnx",
    "VocabPath": "models/embedding/vocab.txt",
    "MaxTokens": 256,
    "ApiProvider": "openai",
    "ApiModel": "text-embedding-3-small"
  },
  "Consolidator": {
    "BatchSize": 1
  },
  "Reflection": {
    "MaxIdeaGeneration": 1,
    "BatchSize": 10,
    "EagernessThreshold": 0.6
  },
  "RoutingManifest": {
    "Agents": {
      "Perception": { "Subscribes": [] },
      "Impulse": { "Subscribes": ["events.perception", "system.control"] },
      "Reasoning": { "Subscribes": ["events.perception"] },
      "Recall": { "Subscribes": ["events.selected-pairs"] },
      "Self": { "Subscribes": ["events.perception", "system.control"] },
      "Governance": { "Subscribes": ["events.perception", "events.advisories", "events.verdict"] },
      "Intent": { "Subscribes": ["events.bundle"] },
      "Security": { "Subscribes": ["events.proposal"] },
      "Action": { "Subscribes": ["events.action"] },
      "Consolidator": { "Subscribes": ["events.bundle"] },
      "Reflection": { "Subscribes": ["events.conclusion"] },
      "ArchiveLogger": { "Subscribes": ["*"] },
      "ConsoleSubscriber": { "Subscribes": ["*"] },
      "SseBroadcaster": { "Subscribes": ["*"] }
    }
  },
  "Sse": {
    "ExcludedMetaKeys": [ "intent.prompt" ]
  },
  "Substrates": {
    "Providers": {
      "openai": {
        "BaseUrl": "https://api.openai.com/v1/",
        "ApiKeyEnvironmentVariable": "OPENAI_API_KEY",
        "TimeoutMs": 30000,
        "CircuitOpenMs": 5000
      },
      "mistral": {
        "BaseUrl": "https://api.mistral.ai/v1/",
        "ApiKeyEnvironmentVariable": "MISTRAL_API_KEY",
        "TimeoutMs": 15000,
        "CircuitOpenMs": 5000
      }
    },
    "Classes": {
      "fast-local": { "Provider": "mock" },
      "slow-local": { "Provider": "mock" },
      "fast-low": { "Provider": "mock" },
      "fast-medium": { "Provider": "mock" },
      "fast-high": { "Provider": "mock" },
      "slow-low": { "Provider": "mock" },
      "slow-medium": { "Provider": "mock" },
      "slow-high": { "Provider": "mock" }
    }
  },
  "AgentSubstrates": {
    "Agents": {
      "Intent": { "Class": "fast-high" },
      "Reasoning": { "Class": "fast-medium" },
      "Recall": { "Class": "fast-low" },
      "Reflection": { "Class": "slow-medium" },
      "Consolidator": { "Class": "slow-low" }
    }
  }
}
