<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\EciCas.Core\EciCas.Core.csproj" />
    <ProjectReference Include="..\EciCas.Bus\EciCas.Bus.csproj" />
    <ProjectReference Include="..\EciCas.Agents\EciCas.Agents.csproj" />
    <ProjectReference Include="..\EciCas.Substrates\EciCas.Substrates.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EciCas.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="config\security-rules.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="toolkits\*.json" Link="Toolkits\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="toolkits\README.md" Link="Toolkits\README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="instructions\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
