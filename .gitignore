# --- ECI-CAS specific ---
# Local Archive data (Phase 0 JSON files / later SQLite / Parquet) —
# generated at runtime, never committed. §5.8 storage phases.
data/archive/
*.jsonl

# Secrets — manifest references env var NAMES only, never values.
# Real keys live in .env, which is never committed.
.env
.env.*
!.env.example
security_rules.json
